#!/usr/bin/env bash
#
# ralph — long-running Claude Code loops: a fresh `claude -p` every iteration,
# and git, not the model, decides what shipped.
#
# Getting started
#   ralph new audit ~/code/my-app    make a loop for a repository
#   ralph edit audit                 write the job into its PROMPT.md
#   ralph start audit                run it in the background
#   ralph review audit               later: what it shipped, what it threw away
#
# Commands
#   ralph new <name> <repo-path>   scaffold a loop from the template. The name is
#                                  a directory and, with WORKTREE=1, the branch
#                                  ralph/<name>, so it has to be usable as both
#   ralph start <name>             run it in the background
#   ralph stop <name>              stop the loop and the agent inside it
#   ralph status [name]            what is running, how long, how far
#   ralph review <name> [n]        what the loop shipped, reverted, and has waiting to merge
#   ralph results <name> [n]       the harness verdict for each iteration (default 20)
#   ralph log <name> [n]           last n lines of the log, rotated files included (default 40)
#   ralph tail <name>              follow the log, across rotations
#   ralph steer <name> "text"      redirect a running loop, starting with the iteration in flight
#   ralph edit <name>              open PROMPT.md in $EDITOR
#   ralph migrate <name>           convert a loop from before config.sh to the current layout
#
# With no arguments it prints this, then the loops you have.
#
# Loops live in $RALPH_HOME (default ~/.claude/ralph), one directory each. The
# harness lives in this repo; loop contents stay on the machine, because they hold
# task state and production details. `log` and `tail` read ralph.log, which holds
# the agent's output and the harness's own errors both; nothing you need is only
# in the ralph.out that `start` leaves beside it.

set -uo pipefail

RALPH_HOME="${RALPH_HOME:-$HOME/.claude/ralph}"

# Follow symlinks to the real checkout, so `ln -s <checkout>/ralph ~/.local/bin/ralph`
# works and ralph.sh, hooks/ and template/ are found next to the real file.
# (macOS readlink has no -f before 12.3, so walk the chain by hand.)
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$link_dir/$self" ;; esac
done
HARNESS="$(cd -P "$(dirname "$self")" && pwd)"
LOOPSH="$HARNESS/ralph.sh"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

die() { red "ralph: $*" >&2; exit 1; }

# shq <word>: that word as a shell will read it back. Every hint below is a
# command the user is meant to paste, and a loop name is a directory and a
# branch, not a label: the name gate in `ralph new` refuses what git refuses,
# and git takes & ; | ( ) $ ` and both quotes. So `ralph new 'a&b'` scaffolded a
# loop that works and then printed "3. ralph start a&b", which a shell runs as
# `ralph start a` in the background followed by `b`. A repo path is worse still.
# printf %q quotes only what needs it — an ordinary name still prints bare — and
# its output is identical under bash 3.2 and 5, unlike `${x//a/b}` (see AGENTS.md).
shq() { printf '%q' "$1"; }

loop_dir() {
  local name="$1"
  [ -n "$name" ] || die "which loop? try: ralph status"
  echo "$RALPH_HOME/$name"
}

# A PID is not an identity. ralph.pid outlives a `kill -9`, the OOM killer and a
# reboot, and after a reboot the kernel hands those low numbers straight back
# out: `kill -0` then says "running" about a stranger. `ralph status` reported a
# dead loop as running, `ralph start` refused to start it ever again, and
# `ralph stop` TERMed and then KILLed that stranger's whole process group.
# `ralph start` runs `bash <harness>/ralph.sh <dir>`, so the loop is the process
# whose command line ends with this loop's directory, and nothing else counts.
pid_of() {
  local dir="$1" pid
  [ -f "$dir/ralph.pid" ] || return 1
  pid="$(cat "$dir/ralph.pid" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  case "$(ps -p "$pid" -o command= 2>/dev/null)" in
    *ralph*.sh*" $dir") ;;
    *) return 1 ;;
  esac
  echo "$pid"
}

# Which layout a directory uses, or 1 if it holds no loop at all:
#   current  settings in config.sh, the loop runs from this repo's ralph.sh,
#            and its PID is in ralph.pid
#   old      the loop has its own ralph.sh with the settings as variables near
#            the top, and writes no ralph.pid
loop_kind() {
  if   [ -f "$1/config.sh" ]; then echo current
  elif [ -f "$1/ralph.sh" ];  then echo old
  else return 1
  fi
}

# What an old-layout loop sets a variable to, near the top of its own ralph.sh.
# Sourcing that file would start the loop, so only the plain assignment is
# evaluated, and a line that would run a command is skipped rather than obeyed.
# `MAX_ITER="${MAX_ITER:-40}"` is the usual shape, so the variable is unset
# first and the environment's value cannot leak into the answer. Empty when the
# loop never set it.
old_var() {
  local dir="$1" var="$2" assign
  assign="$(grep -E "^$var=" "$dir/ralph.sh" 2>/dev/null | grep -v -e '[$](' -e '`')"
  # set +u: the assignment may mention $HOME or another variable it left unset.
  (set +u; unset "$var"; eval "$assign" 2>/dev/null; printf '%s' "${!var-}")
}

# The repository an old-layout loop works in, or ? when its ralph.sh hides it.
old_repo() {
  local repo; repo="$(old_var "$1" REPO)"
  printf '%s' "${repo:-?}"
}

# With no ralph.pid, the loop is whatever process is running its own script.
# The agent it starts carries the same directory on its command line
# (`claude -p --add-dir <dir>`), so only a shell, or the script itself, counts.
#
# `pgrep -f` takes a *regex*, and the loop's directory used to be interpolated
# into it, so a name holding a regex metacharacter was read as syntax. Measured
# over twelve names: a `.` matches any character, so `my.app` was reported
# running with `myXapp`'s PID and `ralph migrate my.app` refused for ever,
# telling the reader to `kill` that stranger; `+ ? * [ ( ^ $ \ {` match
# something the path does not contain, so a running loop read as stopped and
# `ralph migrate` renamed its ralph.sh out from under the live process. The
# pattern below is a constant that only narrows the process list; the directory
# is matched literally, by a quoted `case` pattern, the way `pid_of` does it.
# Quoting is what makes it literal in both bash 3.2 and 5.x — dropping the
# quotes reads tidier and is the bug.
old_pid() {
  local dir="$1" f pid
  # A shell running a script keeps the script open for as long as it runs,
  # however it was started: by full path, as ./ralph.sh from the loop directory,
  # through a symlink. The command line does not say so for `bash ./ralph.sh`,
  # and the working directory does not either, because the old scripts cd into
  # the repo. So ask who has the file open. Missing this is what let migrate
  # rename ralph.sh out from under a live loop.
  for f in "$dir"/ralph*.sh; do
    [ -f "$f" ] || continue
    for pid in $(open_by "$f"); do
      [ "$pid" = "$$" ] && continue
      case "$(ps -p "$pid" -o comm= 2>/dev/null)" in
        *bash|*sh) echo "$pid"; return 0 ;;
      esac
    done
  done
  # Only where no process's open files can be read: match the command line.
  local cmd first
  for pid in $(pgrep -f 'ralph.*\.sh' 2>/dev/null); do
    [ "$pid" = "$$" ] && continue
    cmd="$(ps -p "$pid" -o command= 2>/dev/null)"
    case "$cmd" in
      *"$dir"/ralph*.sh*) ;;
      *) continue ;;
    esac
    first="${cmd%% *}"
    case "${first##*/}" in
      bash|sh|zsh|dash|ralph*.sh) echo "$pid"; return 0 ;;
    esac
  done
  return 1
}

# open_by <file>: the PIDs that have <file> open. lsof where it is installed
# (macOS always); otherwise the /proc/*/fd links Linux keeps, compared with the
# file's physical path because that is what the links hold.
open_by() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -t -- "$1" 2>/dev/null
    return 0
  fi
  [ -d /proc/self/fd ] || return 0
  local real p link
  real="$(cd -P "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" || return 0
  for p in /proc/[0-9]*; do
    for link in "$p"/fd/*; do
      if [ "$(readlink "$link" 2>/dev/null)" = "$real" ]; then
        echo "${p#/proc/}"
        break
      fi
    done
  done 2>/dev/null
}

loop_pid() {
  if [ -f "$1/config.sh" ]; then pid_of "$1"; else old_pid "$1"; fi
}

# ------------------------------------------------------------------ commands

# fill <template> <destination> <name> <repo>: copy a template, replacing
# __NAME__ and __REPO__ with exactly those two strings, and __REPO_SH__ with
# the repo path as a shell word.
#
# The two repo placeholders are two different jobs and both are needed.
# config.sh is *sourced*, so the value fill writes is read a second time by
# bash: `REPO="__REPO__"` let a $ expand, a backtick run, and a " end the
# string and swallow the settings after it — silently, long after `ralph new`
# said "created". __REPO_SH__ is the code position and goes through shq, so
# bash reads back the path the user typed. __REPO__ stays raw for the
# SETUP_CMD comment, which is a line the reader pastes: shq's output is
# correct as a bare word and wrong inside the double quotes it sits in there.
#
# This was sed, and sed reads the value it is handed as syntax, not as a path.
# Three characters a directory may legally hold each broke it, all silently and
# all after "created <dir>": & means the whole match in a replacement, so a repo
# at ~/r&d was written as ~/r__REPO__d; a | ended the s||| early, so sed refused
# the script and the redirect left config.sh zero bytes; and a backslash escaped
# whatever came after it, so ~/a\bc became ~/abc. The loop then failed at its
# first start, blaming a repo path the user had never typed.
#
# ${line//__REPO__/$repo} is not the fix, and that is the trap worth naming:
# bash 5.2 began reading & in a replacement as the matched text, the way sed
# does, and bash 3.2 does not. The two bashes this harness supports would have
# written different config.sh files from the same command. So there is no
# replacement string here at all — cutting the line at the placeholder and
# joining the pieces around the value leaves nothing for any bash to reread.
fill() {
  local src="$1" dst="$2" name="$3" repo="$4" line ph val out
  # `|| [ -n "$line" ]` so a template with no trailing newline keeps its last
  # line. Both of ours have one.
  while IFS= read -r line || [ -n "$line" ]; do
    # __REPO_SH__ first: it has __REPO__ as a prefix, so substituting the
    # shorter one first would leave <path>_SH__ behind.
    for ph in __REPO_SH__ __REPO__ __NAME__; do
      case "$ph" in
        __REPO_SH__) val="$(shq "$repo")" ;;
        __REPO__)    val="$repo" ;;
        *)           val="$name" ;;
      esac
      out=""
      while [ "${line#*"$ph"}" != "$line" ]; do
        out="$out${line%%"$ph"*}$val"
        line="${line#*"$ph"}"
      done
      line="$out$line"
    done
    printf '%s\n' "$line"
  done < "$src" > "$dst"
}

cmd_new() {
  local name="${1:-}" repo="${2:-}"
  if [ -z "$name" ] || [ -z "$repo" ]; then die "usage: ralph new <name> <repo-path>"; fi

  # The name is not a label: it is a directory under $RALPH_HOME and, with the
  # template's WORKTREE=1, the branch ralph/<name> the loop commits to. A name
  # neither will take used to scaffold fine and then fail at every start, in
  # git's words, about a worktree path the user never typed. Judge it here,
  # before anything is written, so the complaint arrives with the name in it.
  case "$name" in
    */*) die "loop name cannot hold a /: $name — a loop is one directory in $RALPH_HOME" ;;
  esac
  git check-ref-format --branch "ralph/$name" >/dev/null 2>&1 \
    || die "loop name is not usable as a git branch: $name — with WORKTREE=1 the loop runs on ralph/$name"

  repo="$(cd "$repo" 2>/dev/null && pwd)" || die "no such directory: ${2:-}"
  [ -d "$repo/.git" ] || die "not a git checkout: $repo"

  local dir="$RALPH_HOME/$name"
  [ -e "$dir" ] && die "loop already exists: $dir"

  # Not every name git accepts is one the filesystem will take: past NAME_MAX,
  # or with $RALPH_HOME somewhere it cannot be made, mkdir failed and the rest
  # ran on anyway, so `ralph new` printed "created <dir>" and exited 0 having
  # written nothing at all. A scaffold the harness could not write is not a
  # scaffold, and the exit status is the only part a script can read.
  mkdir -p "$dir" || die "cannot create the loop directory: $dir"
  cp "$HARNESS/template/PROGRESS.md" "$dir/PROGRESS.md"   # no placeholders in it
  fill "$HARNESS/template/config.sh" "$dir/config.sh" "$name" "$repo"
  fill "$HARNESS/template/PROMPT.md" "$dir/PROMPT.md"     "$name" "$repo"

  green "created $dir"
  dim   "  1. write the job into $dir/PROMPT.md"
  dim   "  2. check the commands in $dir/config.sh"
  dim   "  3. ralph start $(shq "$name")"
}

cmd_start() {
  local name="${1:-}"; local dir; dir="$(loop_dir "$name")" || exit 1
  [ -d "$dir" ] || die "no such loop: $name"
  [ -x "$LOOPSH" ] || die "harness not executable: $LOOPSH"

  local running; running="$(pid_of "$dir")" && die "already running as PID $running"

  nohup bash "$LOOPSH" "$dir" >> "$dir/ralph.out" 2>&1 &
  local pid=$!
  echo "$pid" > "$dir/ralph.pid"
  green "started $name as PID $pid"
  dim   "  ralph status $(shq "$name")   ralph tail $(shq "$name")   ralph stop $(shq "$name")"
}

# An old-layout loop kept its settings in its own ralph.sh, so it cannot be run
# by this repo's ralph.sh and `ralph start`, `stop` and `review` do not know it.
# Migrating copies the settings it actually had into config.sh and moves the old
# script aside; every setting added since keeps its harness default, so the loop
# goes on behaving as it did. PROMPT.md, PROGRESS.md and ralph.log are its
# memory and are not touched.
cmd_migrate() {
  local name="${1:-}"; local dir; dir="$(loop_dir "$name")" || exit 1
  [ -d "$dir" ] || die "no such loop: $name"
  [ -f "$dir/config.sh" ] && die "$name already has a config.sh — nothing to migrate"
  [ -f "$dir/ralph.sh" ] || die "$name has no ralph.sh to read settings from"

  # Converting underneath a running loop would leave it running the script this
  # renames, with a config.sh it never read.
  local running; running="$(old_pid "$dir")" && \
    die "$name is running as PID $running — stop it first: kill $running"

  local repo; repo="$(old_var "$dir" REPO)"
  [ -n "$repo" ] || die "cannot read REPO out of $dir/ralph.sh — write config.sh by hand"

  local max quiet
  max="$(old_var "$dir" MAX_ITER)"
  quiet="$(old_var "$dir" QUIET_STOP)"

  {
    printf '# Settings for the %s loop, written by "ralph migrate" from ralph.sh.old.\n' "$name"
    printf '#\n'
    printf '# Only the settings that loop already had are here. Everything else takes the\n'
    printf '# harness default, which is what it did before: no worktree, no gates, no push.\n'
    printf '# See the template config.sh in the harness for the rest, and turn on WORKTREE=1\n'
    printf '# when you want the harness to check commits instead of keeping them all.\n\n'
    # Shell-quoted for the same reason `fill` does it: config.sh is sourced,
    # so an unquoted $ in the path would expand on the way back in. old_var
    # already refuses a line holding `$(` or a backtick, but a single-quoted
    # literal $ in the old ralph.sh comes through as one.
    printf 'REPO=%s\n' "$(shq "$repo")"
    [ -n "$max" ]   && printf 'MAX_ITER=%s\n' "$max"
    [ -n "$quiet" ] && printf 'QUIET_STOP=%s\n' "$quiet"
  } > "$dir/config.sh"

  mv "$dir/ralph.sh" "$dir/ralph.sh.old"

  green "migrated $name"
  dim   "  settings   $dir/config.sh"
  dim   "  the old script is kept as $dir/ralph.sh.old"
  dim   "  check it, then: ralph start $(shq "$name")"
}

cmd_stop() {
  local name="${1:-}"; local dir; dir="$(loop_dir "$name")" || exit 1
  local pid; pid="$(pid_of "$dir")" || die "$name is not running"

  # TERM lets the loop's trap take down the agent's whole process group (tests,
  # dev servers, MCP servers) and log where it stopped. That can take a few
  # seconds, so wait before reaching for SIGKILL.
  kill "$pid" 2>/dev/null
  local i=0
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done

  if kill -0 "$pid" 2>/dev/null; then
    # Killing only the loop would leave the current `claude -p` orphaned and
    # still writing to the repository.
    local child
    for child in $(pgrep -P "$pid" 2>/dev/null); do
      kill -KILL -- "-$child" 2>/dev/null || kill -KILL "$child" 2>/dev/null
    done
    kill -KILL "$pid" 2>/dev/null
  fi
  rm -f "$dir/ralph.pid"
  green "stopped $name (PID $pid)"
}

# loop_conf <dir>: REPO, WORKTREE, BRANCH, PUSH and the work directory, tab
# separated. config.sh may refer to variables only ralph.sh defines, so it is
# read loosely, with the harness defaults for anything it leaves out.
loop_conf() {
  local dir="$1" name; name="$(basename "$dir")"
  # shellcheck disable=SC1091,SC2034  # DIR is for config.sh lines that mention it
  (set +u; DIR="$dir"; REPO=""; WORKTREE=0; WORKTREE_DIR=""; BRANCH="main"; PUSH=0
   . "$dir/config.sh" >/dev/null 2>&1
   work="$REPO"
   if [ "$WORKTREE" = 1 ]; then
     work="${WORKTREE_DIR:-$(dirname "$REPO")/$(basename "$REPO")-ralph-$name}"
   fi
   printf '%s\t%s\t%s\t%s\t%s' "${REPO:-?}" "$WORKTREE" "$BRANCH" "$PUSH" "$work")
}

# running/stopped, for the first line of either layout's entry.
state_line() {
  local dir="$1" pid uptime
  if pid="$(loop_pid "$dir")"; then
    uptime="$(ps -p "$pid" -o etime= 2>/dev/null | tr -d ' ')"
    printf '\033[32mrunning\033[0m  PID %s  up %s' "$pid" "$uptime"
  else
    printf '\033[2mstopped\033[0m'
  fi
}

# The loop rotates its log, so the history is spread over ralph.log and the
# ralph.log.N behind it. Anything that reads the log reads them all, oldest
# first, or the first rotation of a long run makes it look as if the loop had
# only just started. How many there are is whatever is on disk: LOG_KEEP has no
# ceiling, so assuming a highest number dropped the oldest files silently. The
# sort is numeric because ralph.log.10 sorts under ralph.log.2 by name, which
# would hand the history back shuffled rather than short.
log_files() {
  local f n
  for f in "$1"/ralph.log.[0-9]*; do
    [ -f "$f" ] || continue
    n="${f##*.}"
    case "$n" in *[!0-9]*) continue ;; esac
    printf '%s\t%s\n' "$n" "$f"
  done | sort -rn | cut -f2-
  [ -f "$1/ralph.log" ] && printf '%s\n' "$1/ralph.log"
  return 0
}

log_cat() {
  local f
  while IFS= read -r f; do cat "$f"; done < <(log_files "$1")
}

# Matching lines across every log file. Summing per-file counts, rather than
# grepping one concatenation, so this stays cheap on the tens of megabytes a
# long run leaves behind.
log_count() {
  local f n total=0
  while IFS= read -r f; do
    n="$(grep -a -c "$2" "$f" 2>/dev/null)" || n=0
    total=$((total + n))
  done < <(log_files "$1")
  printf '%s' "$total"
}

# Both layouts write the same log lines, so both are read the same way.
# grep -c prints 0 and exits 1 when it matches nothing: a `|| echo 0` fallback
# here would append a second 0 and split the line in two.
status_iterations() {
  printf '  iterations  %s run, %s shipped a commit\n' \
    "$(log_count "$1" '^\[.*=== iteration')" "$(log_count "$1" 'shipped [0-9a-f]\{40\}')"
}

status_last() {
  local last; last="$(grep -a '^\[' "$1/ralph.log" 2>/dev/null | tail -1)"
  [ -n "$last" ] && printf '  last        %s\n' "$last"
  return 0
}

# Prints one loop, or returns 1 without printing if the directory is not a loop.
# The caller counts the successes, so that a $RALPH_HOME full of other things
# says "no loops" rather than printing nothing at all.
# cost_line <results.tsv>: what the runs cost, from the columns the harness
# fills when claude answers in JSON. Nothing when no run reported a cost. On a
# subscription the dollars are what the API would have charged, not a bill, and
# a run killed before it answered reports nothing, so the sum is a lower bound.
cost_line() {
  awk -F'\t' 'NR > 1 && NF >= 9 {
      if ($8 != "-") { c += $8; any = 1 }
      if ($9 != "-") t += $9
      if ($5 ~ /^keep/) k++
    }
    END {
      if (!any) exit
      printf "$%.2f API-equivalent (a lower bound), %d tokens", c, t
      if (k) printf ", $%.2f per kept commit", c / k
      print ""
    }' "$1"
}

status_one() {
  local dir="$1" name kind
  name="$(basename "$dir")"
  kind="$(loop_kind "$dir")" || return 1

  # An old-layout loop keeps its settings in its own ralph.sh and has no
  # results.tsv and no worktree, so it gets the part of the entry that is true
  # of it: where it works, whether something is running it, and its log.
  if [ "$kind" = old ]; then
    printf '%-20s %s  \033[2m(old layout)\033[0m\n' "$name" "$(state_line "$dir")"
    printf '  repo        %s\n' "$(old_repo "$dir")"
    status_iterations "$dir"
    status_last "$dir"
    echo
    return 0
  fi

  local conf repo worktree work
  conf="$(loop_conf "$dir")"
  repo="$(printf '%s' "$conf" | cut -f1)"
  worktree="$(printf '%s' "$conf" | cut -f2)"
  work="$(printf '%s' "$conf" | cut -f5)"

  printf '%-20s %s\n' "$name" "$(state_line "$dir")"
  printf '  repo        %s\n' "$repo"
  [ "$worktree" = 1 ] && printf '  worktree    %s (ralph/%s)\n' "$work" "$name"
  status_iterations "$dir"
  if [ -f "$dir/results.tsv" ]; then
    local verdicts
    verdicts="$(tail -n +2 "$dir/results.tsv" | cut -f5 | sort | uniq -c | awk '{printf "%s%s %s", sep, $1, $2; sep=", "}')"
    [ -n "$verdicts" ] && printf '  verdicts    %s\n' "$verdicts"
    local cost; cost="$(cost_line "$dir/results.tsv")"
    [ -n "$cost" ] && printf '  cost        %s\n' "$cost"
  fi
  status_last "$dir"
  # No REPO in config.sh leaves the work directory empty, and `git -C ""` is
  # documented to leave the working directory alone — so a loop that died on
  # its own config was reported with the HEAD of whatever repository the reader
  # happened to be standing in, as if it were the loop's.
  local head=""
  [ -n "$work" ] && head="$(git -C "$work" log --oneline -1 2>/dev/null)"
  [ -n "$head" ] && printf '  HEAD        %s\n' "$head"
  echo
}

cmd_status() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    status_one "$RALPH_HOME/$name" || dim "no loop called $name in $RALPH_HOME"
    return
  fi
  [ -d "$RALPH_HOME" ] || { dim "no loops in $RALPH_HOME — ralph new <name> <repo>"; return; }
  local d found=0
  for d in "$RALPH_HOME"/*/; do
    [ -d "$d" ] || continue
    status_one "${d%/}" && found=1
  done
  [ "$found" = 1 ] || dim "no loops in $RALPH_HOME — ralph new <name> <repo>"
}

cmd_log() {
  local name="${1:-}" n="${2:-40}"; local dir; dir="$(loop_dir "$name")" || exit 1
  [ -n "$(log_files "$dir")" ] || die "no log yet for $name"
  log_cat "$dir" | tail -n "$n"
}

cmd_tail() {
  local name="${1:-}"; local dir; dir="$(loop_dir "$name")" || exit 1
  # -F, not -f: a rotation renames the file this is following, and -f would then
  # sit on the old one, silent, for the rest of the run.
  tail -F "$dir/ralph.log"
}

# What a loop did, for a human deciding what to keep: verdict counts, the commits
# it shipped, the ones the gates threw away (kept under refs/ralph/), and, when
# it does not push, what is waiting on ralph/<name> to be merged.
cmd_review() {
  local name="${1:-}" n="${2:-10}"; local dir; dir="$(loop_dir "$name")" || exit 1
  if [ ! -f "$dir/config.sh" ]; then
    # Saying "no such loop" of an old-layout directory is false: it exists, it
    # keeps no results.tsv and nothing here can read it until it is migrated.
    [ -f "$dir/ralph.sh" ] && die "$name is the old layout, with no verdicts to show — convert it first: ralph migrate $(shq "$name")"
    die "no loop called $name in $RALPH_HOME"
  fi
  local conf repo worktree branch push work
  conf="$(loop_conf "$dir")"
  repo="$(printf '%s' "$conf" | cut -f1)"
  worktree="$(printf '%s' "$conf" | cut -f2)"
  branch="$(printf '%s' "$conf" | cut -f3)"
  push="$(printf '%s' "$conf" | cut -f4)"
  work="$(printf '%s' "$conf" | cut -f5)"
  git -C "$work" rev-parse --git-dir >/dev/null 2>&1 || die "cannot read the repository at $work"

  local where="works in $repo"
  if [ "$worktree" = 1 ]; then
    where="works on ralph/$name in $work"
    if [ "$push" = 1 ]; then where="$where, pushes to origin/$branch"
    elif [ "$push" = pr ]; then where="$where, pushes it for a pull request into $branch"
    else where="$where, you merge"; fi
  fi
  printf '%s — %s\n' "$name" "$where"

  local results="$dir/results.tsv"
  if [ -f "$results" ]; then
    printf '\nVerdicts   %s\n' "$(tail -n +2 "$results" | cut -f5 | sort | uniq -c | sort -rn \
      | awk '{printf "%s%s %s", sep, $1, $2; sep=", "}')"
    local cost; cost="$(cost_line "$results")"
    [ -n "$cost" ] && printf 'Cost       %s\n' "$cost"

    printf '\nShipped, newest first\n'
    local sha shown=0
    for sha in $(tail -n +2 "$results" \
                 | awk -F'\t' '$5 ~ /^keep/ {a[n++] = $4} END {for (i = n - 1; i >= 0; i--) print a[i]}'); do
      [ "$shown" -lt "$n" ] || break
      git -C "$work" log -1 --format='  %h  %s' "$sha" 2>/dev/null && shown=$((shown + 1))
    done
    [ "$shown" -gt 0 ] || dim "  nothing yet"
  else
    dim "no verdicts yet"
  fi

  # Newest first, by the epoch the harness put in the refname. Sorting by the
  # refname instead put every refs/ralph/reverted/ above every
  # refs/ralph/dropped/, so a loop with more reverts than this lists never
  # showed a dropped commit at all — and dropped is work thrown away whole,
  # which is the part you most need to see. Numeric, because by name
  # 1758400010-10 sorts under 1758400002-2.
  printf '\nReverted or dropped by the gates, kept under refs/ralph/\n'
  local ref listed=0
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    git -C "$work" log -1 --format="  %h  %s  (${ref#refs/})" "$ref" 2>/dev/null \
      && listed=$((listed + 1))
  done < <(git -C "$work" for-each-ref --format='%(refname)' \
             refs/ralph/reverted/ refs/ralph/dropped/ 2>/dev/null \
           | sort -t/ -k4,4 -rn | head -n "$n")
  [ "$listed" -gt 0 ] || dim "  nothing"

  if [ "$worktree" = 1 ] && [ "$push" != 1 ]; then
    local base="$branch" waiting
    git -C "$work" rev-parse -q --verify "origin/$branch" >/dev/null && base="origin/$branch"
    waiting="$(git -C "$work" log --reverse --format='  %h  %s' "$base..ralph/$name" 2>/dev/null)"
    printf '\nWaiting to merge into %s\n' "$branch"
    if [ -n "$waiting" ]; then
      printf '%s\n' "$waiting"
      if [ "$push" = pr ]; then
        dim "  merge them through the pull request from ralph/$name"
      else
        dim "  merge them: git -C $(shq "$repo") merge $(shq "ralph/$name")"
      fi
    else
      dim "  nothing"
    fi
  fi
  printf '\n'
  dim "look closer: git -C $(shq "$work") show <sha>     every verdict: ralph results $(shq "$name")"
}

cmd_results() {
  local name="${1:-}" n="${2:-20}"; local dir; dir="$(loop_dir "$name")" || exit 1
  [ -f "$dir/results.tsv" ] || die "no results yet for $name"
  { head -n 1 "$dir/results.tsv"; tail -n +2 "$dir/results.tsv" | tail -n "$n"; } \
    | column -t -s "$(printf '\t')"
}

# Two channels. PROMPT.md is re-read at the start of every iteration, so the
# steer holds for every iteration after this one. STEER.md is picked up by a
# PreToolUse hook at the running agent's next tool call (LIVE_STEER=1), so the
# iteration in flight hears it too.
cmd_steer() {
  local name="${1:-}"; shift 2>/dev/null
  local text="${*:-}"
  [ -n "$text" ] || die 'usage: ralph steer <name> "what to do instead"'
  local dir; dir="$(loop_dir "$name")" || exit 1
  [ -f "$dir/PROMPT.md" ] || die "no such loop: $name"

  # The marker is what makes this repeatable: entries always land directly under
  # it, newest first, without re-parsing the prose around them.
  if ! grep -q '<!-- ralph-steer -->' "$dir/PROMPT.md"; then
    {
      printf '\n## Steering\n\n'
      printf 'Added while the loop was running, newest first. These outrank the backlog below.\n\n'
      printf '<!-- ralph-steer -->\n'
    } >> "$dir/PROMPT.md"
  fi

  # ENVIRON and not -v: awk processes escape sequences in a -v value, so a
  # steer naming a Windows path or a regex arrived as `C:<tab>emp<newline>ew`,
  # and the newline put half the entry outside the list. awk does not rescan
  # the environment. STEER.md is written with printf and was never affected,
  # so only the later iterations — the ones that read PROMPT.md — saw the
  # mangled text.
  local tmp; tmp="$(mktemp)"
  RALPH_STEER_ENTRY="- [$(date '+%Y-%m-%d %H:%M')] $text" awk '
    { print }
    /<!-- ralph-steer -->/ && !seen { print ""; print ENVIRON["RALPH_STEER_ENTRY"]; seen = 1 }
  ' "$dir/PROMPT.md" > "$tmp" && mv "$tmp" "$dir/PROMPT.md"
  printf '%s\n' "$text" >> "$dir/STEER.md"
  green "steered $name — the running iteration sees it at its next tool call, and every later one reads it from PROMPT.md"
}

cmd_edit() {
  local name="${1:-}"; local dir; dir="$(loop_dir "$name")" || exit 1
  "${EDITOR:-vi}" "$dir/PROMPT.md"
}

usage() {
  awk 'NR >= 3 && /^#/ { sub(/^# ?/, ""); print; next } NR >= 3 { exit }' "$0"
}

case "${1:-help}" in
  new)    shift; cmd_new    "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  start)  shift; cmd_start  "$@" ;;
  stop)   shift; cmd_stop   "$@" ;;
  status) shift; cmd_status "$@" ;;
  log)    shift; cmd_log    "$@" ;;
  results) shift; cmd_results "$@" ;;
  review) shift; cmd_review "$@" ;;
  tail)   shift; cmd_tail   "$@" ;;
  steer)  shift; cmd_steer  "$@" ;;
  edit)   shift; cmd_edit   "$@" ;;
  -h|--help|help)
    usage
    if [ -d "$RALPH_HOME" ]; then
      loops=""
      for d in "$RALPH_HOME"/*/; do
        kind="$(loop_kind "${d%/}")" || continue
        l="$(basename "$d")"; flags=""
        [ "$kind" = old ] && flags="old layout"
        loop_pid "${d%/}" >/dev/null && flags="${flags:+$flags, }running"
        loops="${loops:+$loops, }$l${flags:+ ($flags)}"
      done
      [ -n "$loops" ] && printf '\nYour loops: %s\n' "$loops"
    fi
    ;;
  *) die "unknown command: $1 (try: ralph help)" ;;
esac
