#!/usr/bin/env bash
# Stand-in for the claude CLI, driven by queue files in $STUB_DIR.
#
# The agent pops its next mode from $STUB_DIR/modes; the reviewer (recognised by
# --restricted) pops its verdict from $STUB_DIR/verdicts. Every prompt read on
# stdin is kept as prompt.agent.N or prompt.review.N so tests can inspect it.

set -u
d="${STUB_DIR:?STUB_DIR not set}"

pop() {
  local q="$d/$1" line
  if [ ! -s "$q" ]; then echo "$2"; return; fi
  line="$(head -n 1 "$q")"
  tail -n +2 "$q" > "$q.tmp" && mv "$q.tmp" "$q"
  echo "$line"
}
bump() {
  local n
  n=$(( $(cat "$d/$1" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$d/$1"
  echo "$n"
}

# --output-format json: answer the way claude does, one result object on stdout
# holding the text, a cost and the token usage. A failed run (exit 1) carries
# its text in errors[] with no result, which is the shape the harness must read
# a limit out of. Needs perl's JSON::PP, the same as the harness's JSON mode.
# shellcheck disable=SC2329  # called by the EXIT trap below
emit_json() {
  local rc=$?
  exec 1>&3
  # shellcheck disable=SC2016  # perl's variables, not the shell's
  perl -MJSON::PP -e '
    local $/; open my $f, "<", $ARGV[0]; my $t = <$f> // "";
    my %r = (type => "result", is_error => ($ARGV[1] ? JSON::PP::true : JSON::PP::false),
             total_cost_usd => $ARGV[2] + 0,
             usage => { input_tokens => $ARGV[3] + 0, output_tokens => $ARGV[4] + 0 });
    if ($ARGV[1]) { $r{errors} = [ $t ] } else { $r{result} = $t }
    print JSON::PP->new->canonical->encode(\%r), "\n";
  ' "$json_out" "$rc" "$cost" "$tin" "$tout"
  rm -f "$json_out"
  exit "$rc"
}
case " $* " in
  *" --output-format json "*)
    json_out="$(mktemp)"
    case " $* " in *" --restricted "*) cost=0.0020 tin=40 tout=10 ;; *) cost=0.0123 tin=100 tout=50 ;; esac
    exec 3>&1 >"$json_out"
    trap emit_json EXIT
    ;;
esac

case " $* " in
  *" --restricted "*)
    n="$(bump review_calls)"
    printf '%s\n' "$@" > "$d/argv.review.$n"
    cat > "$d/prompt.review.$n"
    v="$(pop verdicts ACCEPT)"
    if [ "$v" = LIMIT ]; then
      if [ -f "$d/limit-text" ]; then cat "$d/limit-text"; else echo "You've hit your limit · resets 3am"; fi
      exit 1
    fi
    echo "Read the diff."
    echo "VERDICT: $v"
    exit 0
    ;;
esac

n="$(bump agent_calls)"
printf '%s\n' "$@" > "$d/argv.agent.$n"
cat > "$d/prompt.agent.$n"
env | grep '^BOUNDED_' >> "$d/leaked-env"
mode="$(pop modes nothing)"
echo "$mode" >> "$d/modes.done"

commit() {
  echo "$1 $n" >> work.txt
  git add -A
  git commit -qm "stub: $1 (agent call $n)"
}

# human <command...>: run it in a fresh clone of the remote, as a human
# somewhere else would, without the push block the harness gave the agent.
human() {
  (
    unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
    [ -d "$d/human-clone" ] || git clone -q "$STUB_REMOTE" "$d/human-clone" || exit 1
    cd "$d/human-clone" && git fetch -q origin && git checkout -q -B main origin/main && "$@"
  ) >/dev/null 2>&1
}

# nap <seconds>: sleep as a child and record its PID, so a test can ask whether
# *this* process went with the agent's process group. A plain `sleep 999` leaves
# a command line no test can tell from a sleep a human typed in another
# terminal, and grepping the machine for one is how an unrelated process used to
# fail a run.
nap() {
  sleep "$1" &
  printf '%s\n' "$!" > "$d/sleeper.pid"
  wait "$!"
}

case "$mode" in
  commit)       commit work ;;
  finish)       echo "finished" > FINISHED; commit finish ;;
  commit-bad)   touch BAD; commit bad ;;
  touch-frozen) echo "# edited" >> measure.sh; commit frozen ;;
  cheat)        # commits a failing change, then quietly defangs the check without committing it
                touch BAD; commit cheat; printf '#!/bin/sh\nexit 0\n' > measure.sh ;;
  sleep)        nap 999 ;;
  limit)        echo "You've hit your limit · resets 3am (Europe/Berlin)"; exit 1 ;;
  say-limit)    # a limit whose text the test wrote, reset time and all
                cat "$d/limit-text"; exit 1 ;;
  sicken)       # a commit that breaks production: HEALTH_CMD reads $d/sick
                touch "$d/sick"; commit sicken ;;
  heal)         rm -f "$d/sick"; commit heal ;;
  fail)         echo "boom: something broke"; exit 1 ;;
  credit)       echo "Credit balance is too low"; exit 1 ;;
  weekly)       echo "Weekly limit reached · resets Mon 9am"; exit 1 ;;
  custom-limit) echo "our proxy says: quota window closed"; exit 1 ;;
  fail429)      echo "the audit found: upstream returned HTTP 429 on /login"
                echo "then the agent crashed"; exit 1 ;;
  nothing)      echo "Measured again; nothing new." ;;
  suspend)      # The machine is put to sleep for hours in the middle of the
                # iteration and then woken: `date` jumps by the whole nap while
                # the agent goes on working. Only meaningful with the fake
                # clock the "time asleep" section puts on PATH. FAKE_WORK=999
                # is the same jump with an agent that then really does hang.
                echo "${FAKE_JUMP:-20000}" > "${FAKE_CLOCK:?FAKE_CLOCK not set}"
                nap "${FAKE_WORK:-1}"
                commit work ;;
  grow-progress)
                # PROGRESS.md is the agent's to rewrite, so the agent is what
                # decides whether the shape the entry cap reads ('## Log' with
                # '### ' entries under it) is there at all. This one writes a
                # lot and never that shape, which is how the cap gets switched
                # off by accident and the prompt then grows for ever.
                p="$(dirname "$RALPH_STEER_FILE")/PROGRESS.md"
                i=0
                while [ "$i" -lt 60 ]; do
                  echo "note $n.$i: the agent kept its memory in a shape of its own" >> "$p"
                  i=$((i + 1))
                done ;;
  decide)       # The agent hands something back: text under "Needs a decision"
                # in PROGRESS.md, which is where the escalation prompt tells it
                # to put a blocker. It commits nothing, so this iteration is
                # quiet — which is exactly the shape a human must still hear
                # about, because nothing else in the run says a word.
                # The text holds a quote and a $(...) naming a file under
                # $STUB_DIR: the agent's words reach the notifier as text or
                # they run as a command, and a loop is told to write here.
                # ENVIRON, not -v, because $d is a path and awk rereads a -v
                # value as escape sequences.
                p="$(dirname "$RALPH_STEER_FILE")/PROGRESS.md"
                RALPH_D="$d" awk '{print} /^## Needs a decision/{
                       print ""
                       print "- the staging key is not in the vault: only a human can settle this one \"$(touch " ENVIRON["RALPH_D"] "/OWNED)\""
                     }' "$p" > "$p.new" && mv "$p.new" "$p" ;;
  settle)       # The agent settles one question and moves another up, the way an
                # agent rewriting PROGRESS.md whole does: the section changes,
                # nothing new is asked. (A reworded line is text never seen
                # before, and it may say something new, so it is not tested as
                # silence: telling a rewording from a new question is a guess.)
                p="$(dirname "$RALPH_STEER_FILE")/PROGRESS.md"
                awk '/only a human can settle this one/ {next}
                     /^## Needs a decision/ {print; print ""; print "- an older loop left this one here"; skip = 1; next}
                     skip && /an older loop left this one here/ {next}
                     {print}' "$p" > "$p.new" && mv "$p.new" "$p" ;;
  drop-branch)  # the branch goes out from under the loop, as a stray
                # `git update-ref -d` or a human tidying refs would do
                commit work
                git update-ref -d "$(git symbolic-ref HEAD)" ;;
  branch-collision)
                # A human, or a stray script, makes a branch underneath this
                # loop's own name. refs/heads/ralph/<name> is then a directory
                # and cannot be created again, so the harness cannot put the
                # branch back and the run has to stop.
                commit work
                b="$(git rev-parse --abbrev-ref HEAD)"
                git branch -m "$b" "$b/sub" ;;
  drop-prompt)  # PROMPT.md is the job, and the harness re-reads it every
                # iteration. The agent is told to rewrite PROGRESS.md in the
                # loop directory, so it has write access to PROMPT.md beside
                # it; this is that access used by accident. It commits too, so
                # the gates — including the reviewer, which reads PROMPT.md for
                # the job — run in the same iteration.
                rm -f "$(dirname "$RALPH_STEER_FILE")/PROMPT.md"
                commit work ;;
  drop-progress) # The loop's whole memory, gone. No commit, so this iteration
                # is quiet and only the next prompt shows the damage.
                rm -f "$(dirname "$RALPH_STEER_FILE")/PROGRESS.md" ;;
  push-attempt) commit pushed
                git push -q origin HEAD:main >/dev/null 2>&1
                echo "$?" > "$d/push-attempt.rc"
                # Another repository entirely, with an origin of its own. Only
                # this loop's own origin is out of bounds, so this must work:
                # an agent whose test suite pushes to a throwaway remote has to
                # be able to run it.
                rm -rf "$d/other" "$d/other.git"
                ( git init -q --bare -b main "$d/other.git" \
                  && git init -q -b main "$d/other" \
                  && cd "$d/other" \
                  && git commit -q --allow-empty -m probe \
                  && git remote add origin "$d/other.git" \
                  && git push -q origin main ) >/dev/null 2>&1
                echo "$?" > "$d/push-other.rc" ;;
  human-main)   # a human pushes an unrelated file to main meanwhile
                human sh -c 'echo human > human.txt && git add human.txt && git commit -qm "human: add human.txt" && git push -q origin HEAD:main'
                commit work ;;
  squash)       # a human squash-merges the loop's branch into main, and the
                # host deletes the branch, the way GitHub does after a merge;
                # gh then reports the merged head
                b="$(git rev-parse --abbrev-ref HEAD)"
                # shellcheck disable=SC2016  # $0 and $1 belong to the inner sh
                human sh -c 'git fetch -q origin "$1" && git rev-parse FETCH_HEAD > "$0/gh-merged" \
                  && git merge -q --squash FETCH_HEAD >/dev/null && git commit -qm "human: squash-merge $1" \
                  && git push -q origin HEAD:main && git push -q origin --delete "$1"' "$d" "$b"
                rm -f "$d/gh-open"
                commit work ;;
  foreign)      # a human pushes a commit of their own onto the loop's branch
                b="$(git rev-parse --abbrev-ref HEAD)"
                # shellcheck disable=SC2016  # $0 and $1 belong to the inner sh
                human sh -c 'git fetch -q origin "$1" && git checkout -q -B mine FETCH_HEAD \
                  && echo human > on-branch.txt && git add on-branch.txt && git commit -qm "human: on $1" \
                  && git push -q origin "HEAD:refs/heads/$1" && git rev-parse HEAD > "$0/foreign.sha"' "$d" "$b"
                commit work ;;
  conflict)     # a human pushes to main meanwhile, rewriting the same file
                (
                  unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
                  rm -rf "$d/human"
                  git clone -q "$STUB_REMOTE" "$d/human"
                  cd "$d/human" && echo "human edit" > work.txt \
                    && git commit -qam "human: edit work.txt" && git push -q origin HEAD:main
                )
                echo "agent edit" > work.txt
                git add -A
                git commit -qm "stub: conflicting (agent call $n)" ;;
  *)            echo "stub: unknown mode $mode" >&2; exit 3 ;;
esac
exit 0
