#!/usr/bin/env bun
// Stand-in for the GitHub CLI, driven by files in $STUB_DIR, so PUSH=pr is
// tested without the network. It is on PATH for the whole suite, which also
// means nothing in the suite can ever reach the real gh. Every call is logged
// to $STUB_DIR/gh.calls, one line each.
//
//   gh-auth-fail  present: `gh auth status` fails, as a gh nobody logged in does
//   gh-open       the URL of the open pull request; `pr create` writes it
//   gh-merged     the head sha of the last merged pull request
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const d = process.env.STUB_DIR;
if (!d) {
  process.stderr.write("STUB_DIR not set\n");
  process.exit(2);
}
const args = process.argv.slice(2);
const line = args.join(" ");
appendFileSync(join(d, "gh.calls"), `${line}\n`);
const cat = (f: string) => (existsSync(join(d, f)) ? readFileSync(join(d, f), "utf8") : "");

if (line === "auth status") {
  if (existsSync(join(d, "gh-auth-fail"))) {
    process.stderr.write("You are not logged into any GitHub hosts.\n");
    process.exit(1);
  }
  process.stdout.write("Logged in to github.com as stub\n");
} else if (args[0] === "pr" && args[1] === "list" && line.includes("--state open")) {
  process.stdout.write(cat("gh-open"));
} else if (args[0] === "pr" && args[1] === "list" && line.includes("--state merged")) {
  process.stdout.write(cat("gh-merged"));
} else if (args[0] === "pr" && args[1] === "create") {
  const n = (Number(cat("gh-created").trim()) || 0) + 1;
  writeFileSync(join(d, "gh-created"), `${n}\n`);
  const url = `https://example.invalid/pull/${n}\n`;
  writeFileSync(join(d, "gh-open"), url);
  process.stdout.write(url);
} else {
  process.stderr.write(`gh stub: unhandled: ${line}\n`);
  process.exit(2);
}
